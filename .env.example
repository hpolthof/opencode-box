# Admin dashboard login (required)
ADMIN_PASSWORD=change-me
# Secret used to sign the admin session cookie (required, any long random string)
ADMIN_SESSION_SECRET=change-me-too

# Gateway HTTP port
PORT=8080

# Where the gateway's own SQLite database lives (should be under the /data volume)
DB_PATH=/data/opencode-box.sqlite

# HOME used for the spawned `opencode serve` process, so its config/auth
# (~/.config/opencode, ~/.local/share/opencode) persist under the /data volume
OPENCODE_HOME=/data/opencode-home

# Shell launched by the admin web terminal (/admin/terminal)
# TERMINAL_SHELL=/bin/bash

# Example provider API keys. These are only used if referenced from
# opencode.json via {env:VAR_NAME} interpolation - see README.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
