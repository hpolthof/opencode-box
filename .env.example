# Admin dashboard login (required)
ADMIN_PASSWORD=change-me
# Secret used to sign the admin session cookie (required, any long random string)
ADMIN_SESSION_SECRET=change-me-too

# Gateway HTTP port
PORT=8080

# Where the gateway's own SQLite database lives (should be under the /data volume)
DB_PATH=/data/opencode-box.sqlite

# Optional provider API keys. Keys (or subscription sign-ins) can also be set
# from the admin dashboard (Admin > Providers), which take precedence.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
